# Canonical public origin. The GitHub OAuth callback is intentionally fixed to
# https://gitfriend.xyz/api/auth/github/callback in lib/github-oauth.ts.
NEXT_PUBLIC_APP_URL=https://gitfriend.xyz

# GitHub OAuth App credentials
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM provider. By default Git-Friend talks to Groq.
GROQ_API_KEY=
# Optional low-latency Groq overrides (these are the defaults in the routes).
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_SUGGESTIONS_MODEL=llama-3.1-8b-instant

# Optional: route every LLM call through a LiteLLM proxy instead of Groq,
# unlocking 100+ providers (OpenAI, Anthropic, Gemini, Bedrock, Azure,
# self-hosted, ...) behind one OpenAI-compatible endpoint. When LITELLM_BASE_URL
# is set it takes over; LITELLM_MODEL is the proxy model alias, and
# LITELLM_API_KEY is the proxy virtual key (falls back to GROQ_API_KEY).
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# Firebase application configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set this same value in the Convex deployment settings so it can validate
# Firebase ID tokens.
FIREBASE_PROJECT_ID=

# Optional: enable Convex persistence
NEXT_PUBLIC_CONVEX_URL=
